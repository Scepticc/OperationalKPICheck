# Vercel Postgres connection string (required)
# Get this from your Vercel project dashboard under Storage > Postgres
POSTGRES_URL="postgres://user:password@host/database?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://user:password@host/database?sslmode=require"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="database"
POSTGRES_HOST="host"

# Optional: Set the app URL for production
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
