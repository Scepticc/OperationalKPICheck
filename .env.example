# ─── Neon database connection string (required) ───────────────────────────────
# 1. Create a free project at https://console.neon.tech
# 2. Copy the connection string from: Project → Connection Details
# 3. Paste it here (make sure sslmode=require is included)
#
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Fallback — also accepted if DATABASE_URL is not set
# POSTGRES_URL="postgresql://..."

# Optional: public app URL (used for absolute redirects in production)
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
